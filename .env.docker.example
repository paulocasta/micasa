# Copiar a .env.docker y completar.
# Contraseña de acceso. Vacía = sin login (solo usar en red local de confianza).
APP_PASSWORD=
# Secreto para firmar la sesión. Generar con: openssl rand -hex 32
SESSION_SECRET=
# Poner en true cuando se sirva por HTTPS (VPS con proxy inverso).
COOKIE_SECURE=false
